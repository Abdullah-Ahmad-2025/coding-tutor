# Judge0 (optional - we're using local executor)
JUDGE0_HOST=https://judge0-ce.p.rapidapi.com
JUDGE0_KEY=your_rapidapi_key_here

# Groq API (for hints - Day 3)
GROQ_API_KEY=your_groq_key_here

# Database
# Neon / PostgreSQL example:
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require
# Local SQLite example:
# DATABASE_URL=sqlite:///./coding_tutor.db

# Auth
SECRET_KEY=replace-this-with-a-long-random-secret

# Frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.vercel.app
