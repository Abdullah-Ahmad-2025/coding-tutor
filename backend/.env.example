# Database Configuration
# For SQLite (recommended for free deployment):
DATABASE_URL=sqlite:///coding_tutor.db

# For PostgreSQL (if using external database):
# DATABASE_URL=postgresql://user:password@host:5432/database

# AI API Configuration
GROQ_API_KEY=your_groq_api_key_here

# Security
SECRET_KEY=your_random_secret_key_here_generate_with_openssl_rand_hex_32

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-url.vercel.app
