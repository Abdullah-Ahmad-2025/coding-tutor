# Copy this file to .env.local for local overrides,
# or set these variables in your deployment platform (Railway, Render, Vercel, etc.)

# URL of your deployed FastAPI backend.
# Locally this is not needed — the app falls back to http://localhost:8000 automatically.
# In production, if the frontend and backend share the same origin, this can be omitted.
REACT_APP_API_URL=https://your-backend-url.railway.app
